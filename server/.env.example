API_PORT=4000
CLIENT_ORIGIN=http://localhost:5174

# Supabase project settings -> API -> Project URL (same value as the client's VITE_SUPABASE_URL).
# JWTs are verified against this project's JWKS endpoint, not a shared secret.
SUPABASE_URL=

# Supabase project settings -> API Keys -> service_role (legacy) or a secret key. Server only:
# never put this in the client. Used to upload avatars to the public "avatars" Storage bucket.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase dashboard -> Connect -> "Session pooler" tab (NOT "Direct connection" -- that
# host is IPv6-only on the free plan and will fail to connect from most home networks).
# Session pooler is IPv4 and supports everything `prisma migrate` needs.
# Append ?connection_limit=10 to stay well under the free tier's pool_size=15 cap.
# On Vercel, use the Transaction pooler (port 6543) instead, with
# ?pgbouncer=true&connection_limit=3: each serverless instance opens its own pool.
DATABASE_URL=

# themoviedb.org -> Settings -> API -> API Key (v3 auth)
TMDB_API_KEY=

# Games come from IGDB, which authenticates with a Twitch app: dev.twitch.tv -> Your Console ->
# Applications -> Register (any OAuth redirect URL, e.g. http://localhost; category "Website
# Integration"), then copy the Client ID and generate a Client Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional, and only used until rawg.ts is deleted: RAWG was the games provider until it went down.
RAWG_API_KEY=

# Any long random string (e.g. `openssl rand -hex 32`). Vercel Cron sends it to /api/cron/* as a
# bearer token; set the same value in the Vercel project's environment variables.
CRON_SECRET=

# Contact (email) sent in the User-Agent to Open Library. Identified clients get 3 req/s
# instead of 1. Optional, but set it in production too.
OPEN_LIBRARY_CONTACT=

# Web Push (push notifications). Generate a key pair once with `npx web-push generate-vapid-keys`
# and use the SAME pair locally and on Vercel: there's one database, so subscriptions made in
# local dev are in the live table. Changing the keys invalidates every subscription. Subject is
# a contact for the push services, e.g. mailto:you@example.com. Optional: push is off without them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
