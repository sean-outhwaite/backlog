generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaSource {
  tmdb
  openlibrary
  rawg
}

enum MediaType {
  movie
  tv
  book
  game
}

// A series is stored as a MediaItem of its own (so it can be listed and recommended like any
// title), with its volumes, themselves ordinary title MediaItems, linked via SeriesVolume.
enum MediaKind {
  title
  series
}

enum ListStatus {
  want
  in_progress
  done
}

model Profile {
  id        String   @id
  username  String?  @unique
  // Public URL of the photo in Supabase Storage's avatars bucket. Null shows the username's initial.
  avatarUrl String?
  createdAt DateTime @default(now())

  listEntries             ListEntry[]
  inviteLink              InviteLink?
  friendshipsAsA          Friendship[]     @relation("FriendshipUserA")
  friendshipsAsB          Friendship[]     @relation("FriendshipUserB")
  recommendationsSent     Recommendation[] @relation("RecommendationFrom")
  recommendationsReceived Recommendation[] @relation("RecommendationTo")
  notifications           Notification[]   @relation("NotificationRecipient")
  notificationsCaused     Notification[]   @relation("NotificationActor")
  collections             Collection[]
}

model MediaItem {
  id            String      @id @default(uuid())
  source        MediaSource
  externalId    String
  type          MediaType
  kind          MediaKind   @default(title)
  title         String
  coverImageUrl String?
  description   String?
  releaseYear   Int?
  createdAt     DateTime    @default(now())
  // Series only: when its volumes were last re-fetched from the provider (see refreshSeries).
  // Null means never, so series added before this column existed are refreshed on next use.
  refreshedAt   DateTime?

  listEntries     ListEntry[]
  recommendations Recommendation[]
  volumes         SeriesVolume[]   @relation("SeriesVolumes")
  inSeries        SeriesVolume[]   @relation("VolumeSeries")
  volumeProgress  VolumeProgress[]
  notifications   Notification[]
  collectionItems CollectionItem[]

  // kind is in the key because a provider's series and title ids are separate namespaces.
  @@unique([source, type, kind, externalId])
}

model SeriesVolume {
  seriesId String
  volumeId String
  position Float

  series MediaItem @relation("SeriesVolumes", fields: [seriesId], references: [id])
  volume MediaItem @relation("VolumeSeries", fields: [volumeId], references: [id])

  @@id([seriesId, volumeId])
}

// One user's progress through one volume of a series on their list. No row means "want".
model VolumeProgress {
  entryId     String
  volumeId    String
  status      ListStatus
  completedAt DateTime?

  entry  ListEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  volume MediaItem @relation(fields: [volumeId], references: [id])

  @@id([entryId, volumeId])
}

model ListEntry {
  id          String     @id @default(uuid())
  userId      String
  mediaItemId String
  status      ListStatus @default(want)
  notes       String?
  addedAt     DateTime   @default(now())
  completedAt DateTime?
  // Where the entry sits in the user's list, ascending. Reordering sets it to the midpoint of its new
  // neighbours; new entries go on top (see newEntryPosition in routes/lists).
  position    Float

  user           Profile          @relation(fields: [userId], references: [id])
  mediaItem      MediaItem        @relation(fields: [mediaItemId], references: [id])
  volumeProgress VolumeProgress[]

  @@unique([userId, mediaItemId])
  @@index([userId, position])
}

model InviteLink {
  id        String   @id @default(uuid())
  ownerId   String   @unique
  token     String   @unique
  createdAt DateTime @default(now())

  owner Profile @relation(fields: [ownerId], references: [id])
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA Profile @relation("FriendshipUserA", fields: [userAId], references: [id])
  userB Profile @relation("FriendshipUserB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
}

model Recommendation {
  id          String    @id @default(uuid())
  fromUserId  String
  toUserId    String
  mediaItemId String
  message     String?
  createdAt   DateTime  @default(now())
  // No longer written: whether you've seen a recommendation is its Notification's readAt now.
  viewedAt    DateTime?

  fromUser  Profile   @relation("RecommendationFrom", fields: [fromUserId], references: [id])
  toUser    Profile   @relation("RecommendationTo", fields: [toUserId], references: [id])
  mediaItem MediaItem @relation(fields: [mediaItemId], references: [id])
}

enum NotificationType {
  recommendation
  released
}

// Something to tell a user about, shown in the bell menu. Points at who did it and what it's about
// rather than at the Recommendation itself, so it can be inserted alongside the recommendation
// rather than after it, and so other kinds (a tracked title coming out) share the same shape.
model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  actorId     String?
  mediaItemId String?
  createdAt   DateTime         @default(now())
  readAt      DateTime?

  user      Profile    @relation("NotificationRecipient", fields: [userId], references: [id])
  actor     Profile?   @relation("NotificationActor", fields: [actorId], references: [id])
  mediaItem MediaItem? @relation(fields: [mediaItemId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// "picks" is each user's one list of things they recommend to every friend (created lazily, and
// kept to one per user by a partial unique index in the migration); "custom" lists are named by them.
enum CollectionKind {
  custom
  picks
}

// A named list of titles that friends can browse, separate from the backlog (ListEntry). Called
// "Lists" in the UI.
model Collection {
  id          String         @id @default(uuid())
  ownerId     String
  kind        CollectionKind @default(custom)
  name        String
  description String?
  createdAt   DateTime       @default(now())

  owner Profile          @relation(fields: [ownerId], references: [id])
  items CollectionItem[]

  @@index([ownerId])
}

model CollectionItem {
  collectionId String
  mediaItemId  String
  // Why it's on the list, shown to friends alongside it.
  note         String?
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  mediaItem  MediaItem  @relation(fields: [mediaItemId], references: [id])

  @@id([collectionId, mediaItemId])
}
