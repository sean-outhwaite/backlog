generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaSource {
  tmdb
  openlibrary
  igdb
}

enum MediaType {
  movie
  tv
  book
  game
}

// A series is stored as a MediaItem of its own (so it can be listed and recommended like any
// title), with its volumes, themselves ordinary title MediaItems, linked via SeriesVolume.
enum MediaKind {
  title
  series
}

enum ListStatus {
  want
  in_progress
  done
}

// How a TV show on someone's list is tracked: as one title, season by season, or episode by
// episode. Null for every other type. Every mode is told when a new season comes out; only season
// and episode tracking reopen a finished show for it.
enum TrackingMode {
  show
  season
  episode
}

model Profile {
  id        String   @id
  username  String?  @unique
  // Public URL of the photo in Supabase Storage's avatars bucket. Null shows the username's initial.
  avatarUrl String?
  createdAt DateTime @default(now())

  listEntries             ListEntry[]
  inviteLink              InviteLink?
  friendshipsAsA          Friendship[]     @relation("FriendshipUserA")
  friendshipsAsB          Friendship[]     @relation("FriendshipUserB")
  recommendationsSent     Recommendation[] @relation("RecommendationFrom")
  recommendationsReceived Recommendation[] @relation("RecommendationTo")
  notifications           Notification[]   @relation("NotificationRecipient")
  notificationsCaused     Notification[]   @relation("NotificationActor")
  collections             Collection[]
  pushSubscriptions       PushSubscription[]
}

model MediaItem {
  id               String      @id @default(uuid())
  source           MediaSource
  externalId       String
  type             MediaType
  kind             MediaKind   @default(title)
  title            String
  coverImageUrl    String?
  description      String?
  releaseYear      Int?
  // The exact release date, where the provider gives one.
  releaseDate      DateTime?   @db.Date
  // Not out yet, as of releaseCheckedAt. The daily release check (lib/releases) re-fetches these
  // until they are, then tells whoever's tracking them. Null releaseCheckedAt means it's never
  // been seen as upcoming, so its coming out isn't news (see checkReleases).
  releasePending   Boolean     @default(false)
  releaseCheckedAt DateTime?
  createdAt        DateTime    @default(now())
  // Series: when its volumes were last re-fetched from the provider (see refreshSeries). TV shows:
  // when its seasons were (see refreshShow). Null means never.
  refreshedAt      DateTime?
  // TV shows only, from their last refresh: the latest episode that has aired (so the airing
  // season's episodes so far are known without fetching its episode list), and whether the show
  // has ended or been cancelled, after which it's no longer checked for new seasons.
  lastAiredSeason  Int?
  lastAiredEpisode Int?
  showEnded        Boolean     @default(false)

  listEntries     ListEntry[]
  recommendations Recommendation[]
  volumes         SeriesVolume[]   @relation("SeriesVolumes")
  inSeries        SeriesVolume[]   @relation("VolumeSeries")
  volumeProgress  VolumeProgress[]
  notifications   Notification[]
  collectionItems CollectionItem[]
  seasons         TvSeason[]

  // kind is in the key because a provider's series and title ids are separate namespaces.
  @@unique([source, type, kind, externalId])
  @@index([releasePending])
}

model SeriesVolume {
  seriesId String
  volumeId String
  position Float

  series MediaItem @relation("SeriesVolumes", fields: [seriesId], references: [id])
  volume MediaItem @relation("VolumeSeries", fields: [volumeId], references: [id])

  @@id([seriesId, volumeId])
}

// One season of a TV show (Specials, season 0, are left out), as TMDB last listed it. Stored with
// the show and refreshed with it (see refreshShow); episodes aren't stored, only fetched to show.
model TvSeason {
  showId        String
  number        Int
  name          String
  episodeCount  Int
  airDate       DateTime? @db.Date
  coverImageUrl String?
  // Seen as not out yet (no date, or a future one) at the last refresh. Its premiere is only
  // announced if it was, or if the show had been refreshed before it first appeared.
  upcoming      Boolean   @default(false)

  show MediaItem @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@id([showId, number])
}

// One user's progress through one season of a TV show on their list. No row means "want".
// In episode tracking, episodes holds the numbers watched and status follows from them; a season
// marked done without them (season tracking, or "done") counts as every episode watched.
model SeasonProgress {
  entryId     String
  season      Int
  status      ListStatus
  episodes    Int[]      @default([])
  completedAt DateTime?

  entry ListEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, season])
}

// One user's progress through one volume of a series on their list. No row means "want".
model VolumeProgress {
  entryId     String
  volumeId    String
  status      ListStatus
  completedAt DateTime?

  entry  ListEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  volume MediaItem @relation(fields: [volumeId], references: [id])

  @@id([entryId, volumeId])
}

model ListEntry {
  id          String     @id @default(uuid())
  userId      String
  mediaItemId String
  status      ListStatus @default(want)
  notes       String?
  addedAt     DateTime   @default(now())
  // When it was started and finished: set as its status moves (see statusDates in lib/entryDates),
  // and editable by the user. Null when unknown, e.g. a title added as already finished.
  startedAt   DateTime?
  completedAt DateTime?
  // Where the entry sits in the user's list, ascending. Reordering sets it to the midpoint of its new
  // neighbours; new entries go on top (see newEntryPosition in routes/lists).
  position    Float
  // TV shows only (see TrackingMode).
  tracking    TrackingMode?

  user           Profile          @relation(fields: [userId], references: [id])
  mediaItem      MediaItem        @relation(fields: [mediaItemId], references: [id])
  volumeProgress VolumeProgress[]
  seasonProgress SeasonProgress[]

  @@unique([userId, mediaItemId])
  @@index([userId, position])
}

model InviteLink {
  id        String   @id @default(uuid())
  ownerId   String   @unique
  token     String   @unique
  createdAt DateTime @default(now())

  owner Profile @relation(fields: [ownerId], references: [id])
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA Profile @relation("FriendshipUserA", fields: [userAId], references: [id])
  userB Profile @relation("FriendshipUserB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
}

model Recommendation {
  id          String    @id @default(uuid())
  fromUserId  String
  toUserId    String
  mediaItemId String
  message     String?
  createdAt   DateTime  @default(now())
  // No longer written: whether you've seen a recommendation is its Notification's readAt now.
  viewedAt    DateTime?

  fromUser  Profile   @relation("RecommendationFrom", fields: [fromUserId], references: [id])
  toUser    Profile   @relation("RecommendationTo", fields: [toUserId], references: [id])
  mediaItem MediaItem @relation(fields: [mediaItemId], references: [id])
}

enum NotificationType {
  recommendation
  released
  new_season
}

// Something to tell a user about, shown in the bell menu. Points at who did it and what it's about
// rather than at the Recommendation itself, so it can be inserted alongside the recommendation
// rather than after it, and so other kinds (a tracked title coming out) share the same shape.
model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  actorId     String?
  mediaItemId String?
  // new_season only: which season of the show came out.
  season      Int?
  createdAt   DateTime         @default(now())
  readAt      DateTime?

  user      Profile    @relation("NotificationRecipient", fields: [userId], references: [id])
  actor     Profile?   @relation("NotificationActor", fields: [actorId], references: [id])
  mediaItem MediaItem? @relation(fields: [mediaItemId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// One per browser/device that turned on push notifications (Web Push). The endpoint is the push
// service URL the browser gave us; p256dh and auth are its keys for encrypting payloads. A device
// that someone else signs in on moves to them, since the endpoint is unique.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// "picks" is each user's one list of things they recommend to every friend (created lazily, and
// kept to one per user by a partial unique index in the migration); "custom" lists are named by them.
enum CollectionKind {
  custom
  picks
}

// A named list of titles that friends can browse, separate from the backlog (ListEntry). Called
// "Lists" in the UI.
model Collection {
  id          String         @id @default(uuid())
  ownerId     String
  kind        CollectionKind @default(custom)
  name        String
  description String?
  createdAt   DateTime       @default(now())

  owner Profile          @relation(fields: [ownerId], references: [id])
  items CollectionItem[]

  @@index([ownerId])
}

model CollectionItem {
  collectionId String
  mediaItemId  String
  // Why it's on the list, shown to friends alongside it.
  note         String?
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  mediaItem  MediaItem  @relation(fields: [mediaItemId], references: [id])

  @@id([collectionId, mediaItemId])
}

// What a provider suggests for one title (TMDB recommendations, IGDB similar games), cached for
// the "For you" row on Recommendations. Not per user: everyone with the title shares the row, and
// it's refetched at most daily. results is MediaSearchResult[] straight from the provider, in its order.
model SimilarTitles {
  source     MediaSource
  type       MediaType
  externalId String
  results    Json
  fetchedAt  DateTime

  @@id([source, type, externalId])
}
