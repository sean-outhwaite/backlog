{
  "name": "backlog",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"pnpm --filter client dev\" \"pnpm --filter @backlog/server dev\"",
    "build": "pnpm --filter @backlog/server build && pnpm --filter client build",
    "test": "pnpm --filter @backlog/server test",
    "prisma:generate": "pnpm --filter @backlog/server prisma:generate",
    "prisma:migrate": "pnpm --filter @backlog/server prisma:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "prettier": "^3.9.9"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.2"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
